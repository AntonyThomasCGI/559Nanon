{
    "name":"Nanon Dark",
    "tokenColors":
    [
        {
            "scope":[
                "meta.embedded",
                "source"
            ],
            "settings":{
                "foreground":"#D0DADB"
            }
        },
        {
            "name": "Function Call",
            "scope": [
                "meta.function-call.generic"
            ],
            "settings": {
                "foreground": "#45A9A9"
            }
        },
        {
            "name":"Builtin",
            "scope":"support.function",
            "settings":{
                "foreground":"#45A9A9"
            }
        },
        {
            "name":"Comment",
            "scope":"comment",
            "settings":{
                "fontStyle":"italic",
                "foreground":"#969696"
            }
        },
        {
            "name":"String",
            "scope":"string",
            "settings":{
                "foreground":"#3F9E82"
            }
        },
        {
            "name":"Regexp",
            "scope":"string.regexp",
            "settings":{
                "foreground":"#D3012F"
            }
        },
        {
            "name":"Number",
            "scope":"constant.numeric",
            "settings":{
                "foreground":"#FF0080"
            }
        },
        {
            "name":"Constant",
            "scope":[
                "constant.language"
            ],
            "settings":{
                "foreground":"#45A9A9"
            }
        },
        {
            "name":"Keyword control",
            "scope":"keyword.control",
            "settings":{
                "foreground":"#870087"
            }
        },
        {
            "name":"Keyword operator",
            "scope":"keyword.operator",
            "settings":{
                "foreground":"#870087"
            }
        },
        {
            "name":"Storage",
            "scope":"storage",
            "settings":{
                "fontStyle":"bold",
                "foreground":"#870087"
            }
        },
        {
            "name":"Class name",
            "scope":[
                "entity.name.class",
                "entity.name.type",
                "entity.name.namespace",
                "entity.name.scope-resolution"
            ],
            "settings":{
                "foreground":"#D0DADB"
            }
        },
        {
            "name":"Function name",
            "scope":"entity.name.function",
            "settings":{
                "foreground":"#45A9A9"
            }
        },
        {
            "name": "Parameters",
            "scope": [
                "punctuation.definition.parameters",
                "punctuation.definition.arguments"
            ],
            "settings": {
                "foreground": "#1196A8"
            }
        },
        {
            "name":"Attribute",
            "scope": "meta.attribute",
            "settings": {
                "foreground":"#11A8A8"
            }
        },
        {
            "name":"Variable start",
            "scope":"punctuation.definition.variable",
            "settings":{
                "foreground":"#870087"
            }
        },
        {
            "name":"Embedded code markers",
            "scope":[
                "punctuation.section.embedded.begin",
                "punctuation.section.embedded.end"
            ],
            "settings":{
                "foreground":"#D30102"
            }
        }
    ],
    "colors": {
        "editor.background":"#000000",
        "editor.foreground":"#D0DADB",
        "editor.lineHighlightBackground":"#141414",
        "editorLineNumber.foreground":"#D0DADB",
        "editorLineNumberSpecial.foreground":"#BFFF00",
        "editorRuler.foreground":"#301934",
        "editorSelection.background":"#262626",
        "output.background":"#000000",
        "output.foreground":"#D0DADB",
        "outputSelection.background":"#141414",
        "statusBar.background":"#FFFFFF",
        "statusBar.foreground":"#000000",
        "window.background":"#FFFFFF"
    }
}
